{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "atrium-pi-modelprovider-manager",
  "version": "1.0.1",
  "identifier": "com.atrium.pi.modelprovider.manager",
  "build": {
    "beforeDevCommand": "pnpm dev:ui",
    "devUrl": "http://localhost:8632",
    "beforeBuildCommand": "pnpm build:ui",
    "frontendDist": "../dist/ui"
  },
  "app": {
    "windows": [
      {
        "title": "Atrium - Pi Model Provider Manager",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "templates/test_tasks": "templates/test_tasks"
    }
  }
}
